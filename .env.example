# ==============================================================================
# CRM REDETV! v2 — VARIÁVEIS DE AMBIENTE (MODELO)
# Copie este arquivo para .env e configure os valores adequados para o ambiente.
# ==============================================================================

# Porta da API Node.js
API_PORT=8001

# Conexão e Credenciais do PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=redetv
POSTGRES_DB=crm_redetv
DATABASE_URL=postgresql://postgres:redetv@crm-db-8:5432/crm_redetv

# Portas do Servidor Web Nginx
WEB_HTTP_PORT=8018
WEB_HTTPS_PORT=8448

# Chave secreta para assinatura dos tokens JWT da sessão (Obrigatória em Produção)
# Gere uma chave segura com: openssl rand -base64 32
JWT_SECRET=crm_redetv_secure_production_secret_key_2026_change_me

# Domínios de e-mail corporativos permitidos para login (separados por vírgula)
ALLOWED_DOMAINS=redetv.com.br

# Google Cloud OAuth 2.0 (Google Identity Services, Calendar e Gmail API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Google Gemini AI API Key (Para resumos executivos e inteligência comercial)
GEMINI_API_KEY=

# OpenAI API Key (Para transcrição de áudio com Whisper)
OPENAI_API_KEY=

# Ambiente de execução ('development' ou 'production')
NODE_ENV=production

# Flag de simulação de login local (MANTENHA 'false' EM PRODUÇÃO!)
ALLOW_DEV_MOCK_LOGIN=false
